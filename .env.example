APP_ENV=development
LOG_LEVEL=INFO
LLM_PROVIDER=auto

DATABASE_URL=mysql+pymysql://username:password@localhost:3306/shodhai

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:8b
OLLAMA_TEMPERATURE=0.2
OLLAMA_MAX_TOKENS=2048
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_RETRIES=1

GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TEMPERATURE=0.2
GROQ_MAX_TOKENS=2048
GROQ_TIMEOUT_SECONDS=60

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_PROVIDER=auto
EMBEDDING_DIMENSION=384
FAISS_INDEX_PATH=./data/faiss
UPLOAD_DIR=./data/uploads
MAX_FILE_SIZE_MB=20

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ORIGIN_REGEX=http://(localhost|127\.0\.0\.1):[0-9]+
MAX_PROMPT_CHARS=12000
MAX_REVISION_ATTEMPTS=1
RETRIEVAL_TOP_K=4

WEIGHT_ACCURACY=0.25
WEIGHT_QUALITY=0.25
WEIGHT_COMPLETENESS=0.20
WEIGHT_HALLUCINATION=0.20
WEIGHT_EXECUTION_TIME=0.10

VITE_API_BASE_URL=http://localhost:8000/api
