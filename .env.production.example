# Render backend values. Replace placeholders in the hosting dashboard.
APP_ENV=production
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
OLLAMA_FALLBACK_ENABLED=false
DATABASE_URL=sqlite:////var/data/shodhai.db
UPLOAD_DIR=/var/data/uploads
FAISS_INDEX_PATH=/var/data/faiss
HF_HOME=/var/data/huggingface
EMBEDDING_PROVIDER=sentence-transformers
CORS_ORIGINS=https://YOUR-FRONTEND.vercel.app

# Vercel frontend value, configured separately at build time. Never add API keys.
VITE_API_BASE_URL=https://YOUR-BACKEND.onrender.com/api
